@page "/historicotrabajosespeciales"

@using System.Security.Claims
@using NeoAPTB.DTOs.Bono
@using NeoAPTB.Interfaces
@using NeoAPTB.Interfaces.Bono
@using NeoAPTB.ModelsMyIntelli
@using Radzen

@inject IBonoApiService BonoApiService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject ITempus TempusService
@inject IPersonal PersonalService

<div class="historico-page">

    <h3>Histórico de Trabajos Especiales</h3>

    <RadzenStack Orientation="Orientation.Horizontal"
                AlignItems="AlignItems.End"
                Wrap="FlexWrap.Wrap"
                Gap="0.5rem"
                class="rz-mt-3 historico-filtros">

        <div class="rz-text-align-left" style="margin:0; padding:0;">
            <RadzenLabel Text="Buscar Ficha:" Style="display:block; margin-bottom:4px;" />
            <RadzenTextBox @bind-Value="filtroFicha"
                            Style="width: 120px;"
                            Change="@(_ => AplicarFiltros())" />
        </div>

        <div class="rz-text-align-left" style="margin:0; padding:0;">
            <RadzenLabel Text="Grupo:" Style="display:block; margin-bottom:4px;" />
            <RadzenDropDown TValue="string"
                            Data="@gruposDisponibles"
                            @bind-Value="filtroGrupo"
                            AllowClear="true"
                            Style="width: 90px;"
                            Change="@(_ => AplicarFiltros())" />
        </div>

        <div class="rz-text-align-left" style="margin:0; padding:0;">
            <RadzenLabel Text="Estado:" Style="display:block; margin-bottom:4px;" />
            <RadzenDropDown TValue="int?"
                            Data="@EstadosDisponiblesTab"
                            TextProperty="Nombre"
                            ValueProperty="Id"
                            @bind-Value="filtroEstado"
                            AllowClear="true"
                            Placeholder="Seleccione estado"
                            Style="width: 180px;"
                            Change="@(_ => AplicarFiltros())" />
        </div>

        <div class="rz-text-align-left" style="margin:0; padding:0;">
            <RadzenLabel Text="Desde:" Style="display:block; margin-bottom:4px;" />
            <RadzenDatePicker @bind-Value="fechaDesde"
                            DateFormat="dd/MM/yyyy"
                            AllowClear="true"
                            Style="width: 150px;"
                            Change="@(_ => AplicarFiltros())" />
        </div>

        <div class="rz-text-align-left" style="margin:0; padding:0;">
            <RadzenLabel Text="Hasta:" Style="display:block; margin-bottom:4px;" />
            <RadzenDatePicker @bind-Value="fechaHasta"
                            DateFormat="dd/MM/yyyy"
                            AllowClear="true"
                            Style="width: 150px;"
                            Change="@(_ => AplicarFiltros())" />
        </div>

        <div class="rz-text-align-left" style="margin:0; padding:0;">
            <RadzenLabel Text=" " Style="display:block; margin-bottom:4px;" />
            <RadzenButton Text="Refrescar"
                        Icon="refresh"
                        ButtonStyle="ButtonStyle.Success"
                        Variant="Variant.Flat"
                        Style="width:160px;"
                        Disabled="@(cargandoPagina || cargando)"
                        Click="@(_ => CargarHistorico())" />
        </div>

    </RadzenStack>

    <RadzenTabs @bind-SelectedIndex="tabSeleccionado"
            Change="@((int index) => OnTabChanged(index))"
            class="rz-mt-3">

    <Tabs>
        <RadzenTabsItem Text="En proceso">
        </RadzenTabsItem>

        <RadzenTabsItem Text="Cerrados">
        </RadzenTabsItem>
    </Tabs>
    </RadzenTabs>


    @if (cargandoPagina || cargando || !cargaInicialCompletada)
    {
        <div class="rz-mt-4 carga-pagina-contenedor">
            <div class="spinner"></div>
            <p class="rz-mt-3">Cargando histórico de trabajos especiales...</p>
        </div>
    }
    else if (!dataFiltrada.Any())
    {
        <RadzenCard class="rz-mt-3">
            <p style="margin:0;">
                @MensajeSinRegistros
            </p>
        </RadzenCard>
    }
    else
    {
        <div class="historico-table-box">
            <div class="historico-grid-scroll">
                <div class="historico-grid-inner">

                    <RadzenDataGrid Data="@dataFiltrada"
                                    TItem="EspecialHistoricoVistaDto"
                                    AllowFiltering="false"
                                    AllowSorting="true"
                                    AllowPaging="true"
                                    PageSize="15"
                                    ShowPagingSummary="true"
                                    AllowColumnResize="true"
                                    class="rz-shadow-2 historico-grid"
                                    @ref="gridHistorico">

                        <Columns>
                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Property="PeFicha"
                                                    Title="Ficha"
                                                    Width="90px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center" />

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Property="NombreTrabajador"
                                                    Title="Trabajador"
                                                    Width="220px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center" />

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Property="Rgrupo"
                                                    Title="Grupo"
                                                    Width="70px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center" />

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Property="Rturno"
                                                    Title="Turno"
                                                    Width="70px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center" />

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Property="RhoraTrab"
                                                    Title="Horas"
                                                    Width="80px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center" />

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Title="Motivo"
                                                    Width="250px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center">
                                <Template Context="item">
                                    <div style="white-space: normal;
                                                overflow-wrap: anywhere;
                                                word-break: break-word;
                                                line-height: 1.35;
                                                text-align: center;">
                                        @item.Motivo
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Title="Estado"
                                                    Width="120px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center">
                                <Template Context="item">
                                    <div style="white-space: normal;
                                                overflow-wrap: anywhere;
                                                word-break: break-word;
                                                line-height: 1.35;
                                                text-align: center;">
                                    @ObtenerTextoEstado(item.IdEstado)
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Title="Comentario Rechazo"
                                                    Width="260px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center">
                                <Template Context="item">
                                    @if (item.IdEstado == 5)
                                    {
                                        <div style="white-space: normal;
                                                    overflow-wrap: anywhere;
                                                    word-break: break-word;
                                                    line-height: 1.35;
                                                    text-align: center;">
                                            @(string.IsNullOrWhiteSpace(item.ComentarioRechazo)
                                                ? "Sin comentario"
                                                : item.ComentarioRechazo)
                                        </div>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Title="Fecha Solicitud"
                                                    Width="130px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center">
                                <Template Context="item">
                                    @(item.FechaSolicitud?.ToString("dd/MM/yyyy"))
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Title="Cargado por"
                                                    Width="180px"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center">
                                <Template Context="item">
                                    @item.RuserVali
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="EspecialHistoricoVistaDto"
                                                    Title="Acciones"
                                                    Width="190px"
                                                    Filterable="false"
                                                    Sortable="false"
                                                    TextAlign="TextAlign.Center"
                                                    HeaderCssClass="header-center">
                                <Template Context="item">
                                    <RadzenButton Text="@ObtenerTextoBotonHistorial(item.IdEspecial)"
                                                    Icon="@ObtenerIconoBotonHistorial(item.IdEspecial)"
                                                    ButtonStyle="ButtonStyle.Info"
                                                    Variant="Variant.Flat"
                                                    Size="ButtonSize.Small"
                                                    Style="min-width: 160px;"
                                                    Click="@(_ => VerHistorial(item))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>

                    </RadzenDataGrid>

                </div>
            </div>
        </div>
    }

    @if (idEspecialHistorialAbierto.HasValue)
    {
        <RadzenCard class="rz-mt-4">
            <h5>Historial del pago especial</h5>

            <div class="historial-info-header">
                <b>Cargado por:</b>
                <span>
                    @(string.IsNullOrWhiteSpace(usuarioCargaSeleccionado)
                        ? "No disponible"
                        : usuarioCargaSeleccionado)
                </span>
            </div>

            @if (!historialSeleccionado.Any())
            {
                <p class="rz-mt-3">
                    Este pago especial no tiene historial registrado.
                </p>
            }
            else
            {
                <RadzenDataGrid Data="@historialSeleccionado"
                                TItem="HistorialEspecialItemDto"
                                AllowPaging="true"
                                PageSize="5"
                                AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="HistorialEspecialItemDto"
                                                Property="Nivel"
                                                Title="Nivel"
                                                Width="90px" />

                        <RadzenDataGridColumn TItem="HistorialEspecialItemDto"
                                                Property="UsuarioAprobador"
                                                Title="Usuario"
                                                Width="180px" />

                        <RadzenDataGridColumn TItem="HistorialEspecialItemDto"
                                                Property="Accion"
                                                Title="Acción"
                                                Width="140px" />

                        <RadzenDataGridColumn TItem="HistorialEspecialItemDto"
                                                Title="Comentario"
                                                Width="260px">
                            <Template Context="item">
                                @if (string.IsNullOrWhiteSpace(item.Comentario))
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <div style="white-space: normal;
                                                overflow-wrap: anywhere;
                                                word-break: break-word;">
                                        @item.Comentario
                                    </div>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="HistorialEspecialItemDto"
                                                Title="Fecha"
                                                Width="180px">
                            <Template Context="item">
                                @item.FechaAccion.ToString("dd/MM/yyyy")
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenCard>
    }

</div>

@code {
    private RadzenDataGrid<EspecialHistoricoVistaDto>? gridHistorico;

    private List<EspecialPendienteDto> dataPendientesBase = new();
    private List<EspecialHistoricoDto> dataCerradosBase = new();

    private List<EspecialHistoricoVistaDto> dataBase = new();
    private List<EspecialHistoricoVistaDto> dataFiltrada = new();

    private int tabSeleccionado = 0; // 0 = En proceso, 1 = Cerrados
    private List<HistorialEspecialItemDto> historialSeleccionado = new();

    private bool cargando = false;
    private bool cargaInicialCompletada = false;
    private bool cargandoPagina = true;

    private string filtroFicha = string.Empty;
    private string? filtroGrupo = null;
    private int? filtroEstado = null;

    private DateTime? fechaDesde;
    private DateTime? fechaHasta;

    private int? idEspecialHistorialAbierto;
    private string? usuarioCargaSeleccionado;

    private string? rolUsuario;
    private int centroUsuarioActual = 0;
    private string? nombreCentroUsuario;

    private HashSet<int> idsPersonalCentroUsuario = new();

    private readonly List<string> gruposDisponibles = new() { "A", "B", "C", "D", "N" };

    private readonly List<EstadoFiltroDto> estadosPendientesDisponibles = new()
    {
        new EstadoFiltroDto { Id = 1, Nombre = "Pendiente Superintendente" },
        new EstadoFiltroDto { Id = 2, Nombre = "Pendiente Gerente Área" },
        new EstadoFiltroDto { Id = 3, Nombre = "Pendiente Gerente Manufactura" }
    };

    private readonly List<EstadoFiltroDto> estadosCerradosDisponibles = new()
    {
        new EstadoFiltroDto { Id = 4, Nombre = "Aprobado" },
        new EstadoFiltroDto { Id = 5, Nombre = "Rechazado" }
    };

    private string MensajeSinRegistros =>
    tabSeleccionado == 0
        ? "No hay trabajos especiales en proceso para mostrar."
        : "No hay trabajos especiales cerrados para mostrar.";

    private List<EstadoFiltroDto> EstadosDisponiblesTab =>
        tabSeleccionado == 0
            ? estadosPendientesDisponibles
            : estadosCerradosDisponibles;

    protected override async Task OnInitializedAsync()
    {
        cargandoPagina = true;
        cargaInicialCompletada = false;

        try
        {
            await CargarClaimsUsuario();
            await CargarPersonalPermitidoCentro();
            await CargarHistorico();
        }
        finally
        {
            cargaInicialCompletada = true;
            cargandoPagina = false;
        }
    }

    private async Task CargarClaimsUsuario()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        rolUsuario = user.Claims
        .FirstOrDefault(c => c.Type.Contains("role"))?.Value?
        .Trim();

        var centroClaim = user.Claims
            .FirstOrDefault(c => c.Type == "IdCentro")?.Value;

        if (int.TryParse(centroClaim, out var centro))
        {
            centroUsuarioActual = centro;
        }

        nombreCentroUsuario = user.Claims
            .FirstOrDefault(c => c.Type == "Centro")?.Value;
    }

    private async Task CargarPersonalPermitidoCentro()
    {
        idsPersonalCentroUsuario.Clear();

        // Admin ve todos los centros, no necesita cargar personal por centro.
        if (EsAdminGlobal())
            return;

        if (centroUsuarioActual <= 0)
            return;

        var listaMyIntelli = await TempusService.GetListaMyIntelli(centroUsuarioActual)
            ?? new List<TrabajadorEnPuestoVMi>();

        var fichasCentro = listaMyIntelli
            .Select(x => x.CodigoTrabajador?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();

        if (!fichasCentro.Any())
            return;

        var personalSistema = await PersonalService.GetPersonalPorFichasTexto(fichasCentro);

        idsPersonalCentroUsuario = personalSistema
            .Where(p => p.IdPersonal > 0)
            .Select(p => p.IdPersonal)
            .ToHashSet();
    }

    private bool EsAdminGlobal()
    {
        return string.Equals(
            rolUsuario?.Trim(),
            "Admin",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task CargarHistorico()
    {
        cargando = true;

        try
        {
            dataPendientesBase = await BonoApiService.ObtenerEspecialesPendientesAsync();
            dataCerradosBase = await BonoApiService.ObtenerHistoricoEspecialesAsync();

            dataBase = dataPendientesBase
                .Select(MapearPendienteAVista)
                .Concat(dataCerradosBase.Select(MapearCerradoAVista))
                .ToList();

            AplicarFiltros();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al consultar trabajos especiales",
                Detail = ex.Message,
                Duration = 5000
            });
        }
        finally
        {
            cargando = false;
        }
    }

    private EspecialHistoricoVistaDto MapearPendienteAVista(EspecialPendienteDto item)
    {
        return new EspecialHistoricoVistaDto
        {
            IdEspecial = item.IdEspecial,
            IdResumen = item.IdResumen,
            IdEstado = item.IdEstado,
            Motivo = item.Motivo,
            FechaSolicitud = item.FechaSolicitud,
            IdPersonal = item.IdPersonal,
            PeFicha = item.PeFicha,
            NombreTrabajador = item.NombreTrabajador,
            Rgrupo = item.Rgrupo,
            Rturno = item.Rturno,
            RhoraTrab = item.RhoraTrab,
            RuserVali = item.RuserVali,
            ComentarioRechazo = null
        };
    }

    private EspecialHistoricoVistaDto MapearCerradoAVista(EspecialHistoricoDto item)
    {
        return new EspecialHistoricoVistaDto
        {
            IdEspecial = item.IdEspecial,
            IdResumen = item.IdResumen,
            IdEstado = item.IdEstado,
            Motivo = item.Motivo,
            FechaSolicitud = item.FechaSolicitud,
            IdPersonal = item.IdPersonal,
            PeFicha = item.PeFicha,
            NombreTrabajador = item.NombreTrabajador,
            Rgrupo = item.Rgrupo,
            Rturno = item.Rturno,
            RhoraTrab = item.RhoraTrab,
            RuserVali = item.RuserVali,
            ComentarioRechazo = item.ComentarioRechazo
        };
    }

    private void AplicarFiltros()
    {
        IEnumerable<EspecialHistoricoVistaDto> query = dataBase;

        // Si NO es Admin, filtra por centro.
        if (!EsAdminGlobal())
        {
            if (!idsPersonalCentroUsuario.Any())
            {
                dataFiltrada = new List<EspecialHistoricoVistaDto>();
                return;
            }

            query = query.Where(x => idsPersonalCentroUsuario.Contains(x.IdPersonal));
        }

        // Filtro por pestaña
        if (tabSeleccionado == 0)
        {
            query = query.Where(x => x.IdEstado == 1 || x.IdEstado == 2 || x.IdEstado == 3);
        }
        else
        {
            query = query.Where(x => x.IdEstado == 4 || x.IdEstado == 5);
        }

        if (!string.IsNullOrWhiteSpace(filtroFicha))
        {
            var fichaBuscada = filtroFicha.Trim();

            query = query.Where(x =>
                !string.IsNullOrWhiteSpace(x.PeFicha) &&
                x.PeFicha.Contains(fichaBuscada, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroGrupo))
        {
            var grupoBuscado = filtroGrupo.Trim().ToUpperInvariant();

            query = query.Where(x =>
                !string.IsNullOrWhiteSpace(x.Rgrupo) &&
                x.Rgrupo.Trim().ToUpperInvariant() == grupoBuscado);
        }

        if (filtroEstado.HasValue)
        {
            query = query.Where(x => x.IdEstado == filtroEstado.Value);
        }

        if (fechaDesde.HasValue)
        {
            query = query.Where(x =>
                x.FechaSolicitud.HasValue &&
                x.FechaSolicitud.Value.Date >= fechaDesde.Value.Date);
        }

        if (fechaHasta.HasValue)
        {
            query = query.Where(x =>
                x.FechaSolicitud.HasValue &&
                x.FechaSolicitud.Value.Date <= fechaHasta.Value.Date);
        }

        dataFiltrada = query
            .OrderBy(x => x.IdEstado)
            .ThenByDescending(x => x.FechaSolicitud)
            .ToList();
    }

    private void OnTabChanged(int index)
    {
        tabSeleccionado = index;

        filtroEstado = null;
        idEspecialHistorialAbierto = null;
        usuarioCargaSeleccionado = null;
        historialSeleccionado.Clear();

        AplicarFiltros();
    }
    
    private async Task VerHistorial(EspecialHistoricoVistaDto item)
    {
        try
        {
            if (idEspecialHistorialAbierto == item.IdEspecial)
            {
                historialSeleccionado.Clear();
                idEspecialHistorialAbierto = null;
                usuarioCargaSeleccionado = null;
                return;
            }

            var response = await BonoApiService.ObtenerHistorialEspecialAsync(item.IdEspecial);

            historialSeleccionado = response?.Data ?? new List<HistorialEspecialItemDto>();
            idEspecialHistorialAbierto = item.IdEspecial;

            usuarioCargaSeleccionado = string.IsNullOrWhiteSpace(item.RuserVali)
                ? "No disponible"
                : item.RuserVali;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Error al consultar historial",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }

    private string ObtenerTextoEstado(int estado)
    {
        return estado switch
        {
            1 => "Pendiente Superintendente",
            2 => "Pendiente Gerente Área",
            3 => "Pendiente Gerente Manufactura",
            4 => "Aprobado",
            5 => "Rechazado",
            _ => "Sin estado"
        };
    }

    private string ObtenerTextoBotonHistorial(int idEspecial)
    {
        return idEspecialHistorialAbierto == idEspecial
            ? "Ocultar Historial"
            : "Ver Historial";
    }

    private string ObtenerIconoBotonHistorial(int idEspecial)
    {
        return idEspecialHistorialAbierto == idEspecial
            ? "visibility_off"
            : "visibility";
    }

    private class EspecialHistoricoVistaDto
    {
        public int IdEspecial { get; set; }
        public int IdResumen { get; set; }
        public int IdEstado { get; set; }
        public string? Motivo { get; set; }
        public DateTime? FechaSolicitud { get; set; }

        public int IdPersonal { get; set; }
        public string? PeFicha { get; set; }
        public string? NombreTrabajador { get; set; }

        public string? Rgrupo { get; set; }
        public int Rturno { get; set; }
        public int RhoraTrab { get; set; }
        public string? RuserVali { get; set; }

        public string? ComentarioRechazo { get; set; }
    }
}