@page "/aprobacion-trabajos-especiales"

@using System.Security.Claims
@using NeoAPTB.DTOs.Bono
@using NeoAPTB.Interfaces.Bono
@using Radzen

@inject IBonoApiService BonoApiService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject DialogService DialogService

<h3>Aprobación de Trabajos Especiales</h3>

<RadzenStack Orientation="Orientation.Horizontal"
            AlignItems="AlignItems.End"
            Wrap="FlexWrap.Wrap"
            Gap="0.5rem"
            class="rz-mt-3">

    <div class="rz-text-align-left" style="margin:0; padding:0;">
        <RadzenLabel Text="Buscar Ficha:" style="display:block; margin-bottom:4px;" />
        <RadzenTextBox @bind-Value="filtroFicha"
                    Style="width: 110px;"
                    Change="@(_ => AplicarFiltros())" />
    </div>

    <div class="rz-text-align-left" style="margin:0; padding:0;">
        <RadzenLabel Text="Filtrar Grupo:" style="display:block; margin-bottom:4px;" />
        <RadzenDropDown TValue="string"
                        Data="@gruposDisponibles"
                        @bind-Value="filtroGrupo"
                        AllowClear="true"
                        Style="width: 90px;"
                        Change="@(_ => AplicarFiltros())" />
    </div>

    <div class="rz-text-align-left" style="margin:0; padding:0;">
        <RadzenLabel Text="Filtrar por Estado:" style="display:block; margin-bottom:4px;" />
        <RadzenDropDown TValue="int?"
                        Data="@estadosDisponibles"
                        TextProperty="Nombre"
                        ValueProperty="Id"
                        @bind-Value="filtroEstado"
                        AllowClear="true"
                        Placeholder="Seleccione estado"
                        Style="width: 280px;"
                        Change="@(_ => AplicarFiltros())" />
    </div>

    <div class="rz-text-align-left" style="margin:0; padding:0;">
        <RadzenLabel Text=" " style="display:block; margin-bottom:4px;" />
        <RadzenButton Text="Refrescar"
                    Icon="refresh"
                    ButtonStyle="ButtonStyle.Success"
                    Variant="Variant.Flat"
                    Style="width:180px;"
                    Click="@(_ => CargarPendientes())" />
    </div>

</RadzenStack>

@if (cargando)
{
    <p class="rz-mt-3">Cargando pendientes...</p>
}
else
{
    <RadzenDataGrid Data="@dataFiltrada"
                    TItem="EspecialPendienteDto"
                    AllowFiltering="false"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="15"
                    ShowPagingSummary="true"
                    class="rz-shadow-2 rz-mt-3"
                    @ref="gridPendientes">

        <Columns>
            <RadzenDataGridColumn TItem="EspecialPendienteDto" Property="IdPersonal" Title="Ficha" Width="65px" TextAlign="TextAlign.Center" HeaderCssClass="header-center" />
            <RadzenDataGridColumn TItem="EspecialPendienteDto" Property="Rgrupo" Title="Grupo" Width="70px" TextAlign="TextAlign.Center" HeaderCssClass="header-center" />
            <RadzenDataGridColumn TItem="EspecialPendienteDto" Property="Rturno" Title="Turno" Width="70px" TextAlign="TextAlign.Center" HeaderCssClass="header-center" />
            <RadzenDataGridColumn TItem="EspecialPendienteDto" Title="Motivo" Width="260px"TextAlign="TextAlign.Center" HeaderCssClass="header-center">
                <Template Context="item">
                    <div style="white-space: normal;
                                overflow-wrap: anywhere;
                                word-break: break-word;
                                line-height: 1.35;
                                text-align: center;">
                        @item.Motivo
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EspecialPendienteDto" Title="Estado" Width="160px" TextAlign="TextAlign.Center"HeaderCssClass="header-center">
                <Template Context="item">
                    <div style="white-space: normal;
                                overflow-wrap: anywhere;
                                word-break: break-word;
                                line-height: 1.35;
                                text-align: center;">
                        @ObtenerTextoEstado(item.IdEstado)
                    </div>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="EspecialPendienteDto" Title="Fecha Solicitud" Width="122px" TextAlign="TextAlign.Center" HeaderCssClass="header-center">
                <Template Context="item">
                    @(item.FechaSolicitud?.ToString("dd/MM/yyyy"))
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="EspecialPendienteDto"
                                Title="Acciones" 
                                Width="390px" 
                                Filterable="false" 
                                Sortable="false" 
                                TextAlign="TextAlign.Center" 
                                HeaderCssClass="header-center">
                <Template Context="item">
                <RadzenButton Text="@ObtenerTextoBotonHistorial(item.IdEspecial)"
                            Icon="@ObtenerIconoBotonHistorial(item.IdEspecial)"
                            ButtonStyle="ButtonStyle.Info"
                            Variant="Variant.Flat"
                            Size="ButtonSize.Small"
                            Style="min-width: 180px;"
                            class="rz-mr-1"
                            Click="@(_ => VerHistorial(item))" />

                    <RadzenButton Text="Aprobar"
                                Icon="check"
                                ButtonStyle="ButtonStyle.Success"
                                Variant="Variant.Flat"
                                Size="ButtonSize.Small"
                                class="rz-mr-1"
                                Disabled="@(!PuedeAccionar(item))"
                                Click="@(_ => Aprobar(item))" />

                    <RadzenButton Text="Rechazar"
                                Icon="close"
                                ButtonStyle="ButtonStyle.Danger"
                                Variant="Variant.Flat"
                                Size="ButtonSize.Small"
                                Disabled="@(!PuedeAccionar(item))"
                                Click="@(_ => Rechazar(item))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@if (historialSeleccionado.Any())
{
    <RadzenCard class="rz-mt-4">
        <h5>Historial del registro seleccionado</h5>

        <div class="historial-info-header">
            <b>Cargado por:</b>
            <span>
                @(string.IsNullOrWhiteSpace(usuarioCargaSeleccionado)
                    ? "No disponible"
                    : usuarioCargaSeleccionado)
            </span>
        </div>

        <RadzenDataGrid Data="@historialSeleccionado"
                        TItem="HistorialEspecialItemDto"
                        AllowPaging="true"
                        PageSize="5"
                        AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="HistorialEspecialItemDto" Property="Nivel" Title="Nivel" Width="90px" />
                <RadzenDataGridColumn TItem="HistorialEspecialItemDto" Property="UsuarioAprobador" Title="Usuario" Width="180px" />
                <RadzenDataGridColumn TItem="HistorialEspecialItemDto" Property="Accion" Title="Acción" Width="140px" />
                <RadzenDataGridColumn TItem="HistorialEspecialItemDto" Property="Comentario" Title="Comentario" Width="240px" />
                <RadzenDataGridColumn TItem="HistorialEspecialItemDto" Title="Fecha" Width="180px">
                    <Template Context="item">
                        @item.FechaAccion.ToString("dd/MM/yyyy")
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private RadzenDataGrid<EspecialPendienteDto>? gridPendientes;

    private List<EspecialPendienteDto> dataBase = new();
    private List<EspecialPendienteDto> dataFiltrada = new();
    private List<HistorialEspecialItemDto> historialSeleccionado = new();

    private bool cargando = false;

    private string filtroFicha = string.Empty;
    private string? filtroGrupo = null;
    private int? filtroEstado = null;

    private string? usuarioActual;
    private string? fichaUsuario;
    private string? registroUsuario;

    private string? usuarioCargaSeleccionado;
    private int? idEspecialHistorialAbierto = null;

    private readonly List<string> gruposDisponibles = new() { "A", "B", "C", "D", "N" };

    private readonly List<EstadoFiltroDto> estadosDisponibles = new()
    {
        new EstadoFiltroDto { Id = 1, Nombre = "Pendiente Superintendente" },
        new EstadoFiltroDto { Id = 2, Nombre = "Pendiente Gerente Area" },
        new EstadoFiltroDto { Id = 3, Nombre = "Pendiente Gerente Manufactura" }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        fichaUsuario = user.Claims
            .FirstOrDefault(c => c.Type == "Ficha")?.Value?
            .Trim()
            .ToUpperInvariant();

        var nombre = user.Claims
            .FirstOrDefault(c => c.Type.Contains("givenname"))?.Value?
            .Trim();

        var apellido = user.Claims
            .FirstOrDefault(c => c.Type.Contains("surname"))?.Value?
            .Trim();

        registroUsuario = $"{nombre} {apellido}".Trim();

        if (string.IsNullOrWhiteSpace(registroUsuario))
        {
            registroUsuario = fichaUsuario ?? user.Identity?.Name ?? "Usuario";
        }

        usuarioActual = registroUsuario;

        await CargarPendientes();
    }

    private async Task CargarPendientes()
    {
        cargando = true;

        try
        {
            dataBase = await BonoApiService.ObtenerEspecialesPendientesAsync();
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al consultar pendientes",
                Detail = ex.Message,
                Duration = 5000
            });
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarFiltros()
    {
        IEnumerable<EspecialPendienteDto> query = dataBase;

        // Primero filtramos por lo que el usuario puede ver
        query = query.Where(DebeVerRegistro);

        // Filtro por ficha / IdPersonal
        if (!string.IsNullOrWhiteSpace(filtroFicha))
        {
            var fichaBuscada = filtroFicha.Trim();
            query = query.Where(x => x.IdPersonal.ToString().Contains(fichaBuscada));
        }

        // Filtro por grupo
        if (!string.IsNullOrWhiteSpace(filtroGrupo))
        {
            var grupoBuscado = filtroGrupo.Trim().ToUpperInvariant();
            query = query.Where(x =>
                (x.Rgrupo ?? string.Empty).Trim().ToUpperInvariant() == grupoBuscado);
        }

        // Filtro por estado
        if (filtroEstado.HasValue)
        {
            query = query.Where(x => x.IdEstado == filtroEstado.Value);
        }

        dataFiltrada = query
            .OrderBy(x => x.IdEstado)
            .ThenByDescending(x => x.FechaSolicitud)
            .ToList();
    }

    private bool DebeVerRegistro(EspecialPendienteDto item)
    {
        var nivelPermitido = ObtenerNivelPermitidoUsuario();

        if (nivelPermitido == 0)
            return false;

        /*
        * Regla:
        * - J4656 ve niveles 1, 2 y 3, pero solo acciona el 1.
        * - J4169 ve niveles 2 y 3, pero solo acciona el 2.
        * - Admin ve nivel 3, y solo acciona el 3.
        * - Estados 4 y 5 ya no se ven aquí.
        */
        return item.IdEstado >= nivelPermitido && item.IdEstado < 4;
    }

    private bool PuedeAccionar(EspecialPendienteDto item)
    {
        var nivelPermitido = ObtenerNivelPermitidoUsuario();

        if (nivelPermitido == 0)
            return false;

        // Solo puede aprobar/rechazar cuando el registro está exactamente en su nivel
        return item.IdEstado == nivelPermitido;
    }

    private int ObtenerNivelPermitidoUsuario()
    {
        var ficha = fichaUsuario?.Trim().ToUpperInvariant();

        return ficha switch
        {
            "J4656" => 1,
            "J4169" => 2,
            "ADMIN" => 3,
            _ => 0
        };
    }

    private async Task Aprobar(EspecialPendienteDto item)
    {
        try
        {
            if (!PuedeAccionar(item))
                return;

            var (nuevoEstado, nivel, comentario) = item.IdEstado switch
            {
                1 => (2, 1, "Aprobado por Superintendente"),
                2 => (3, 2, "Aprobado por Gerente de Área"),
                3 => (4, 3, "Aprobado por Gerente de Manufactura"),
                _ => (item.IdEstado, 0, string.Empty)
            };

            if (nivel == 0)
                return;

            var dto = new ActualizarEstadoEspecialDto
            {
                NuevoIdEstado = nuevoEstado,
                Nivel = nivel,
                UsuarioAprobador = registroUsuario ?? usuarioActual ?? "Usuario",
                Comentario = comentario
            };

            await BonoApiService.ActualizarEstadoEspecialAsync(item.IdEspecial, dto);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Aprobación exitosa",
                Detail = nuevoEstado == 4
                    ? "El pago especial fue aprobado definitivamente."
                    : "El pago especial fue enviado al siguiente nivel de aprobación.",
                Duration = 4000
            });

            // Recarga desde la API.
            // Si pasa a 2 o 3, seguirá visible según el usuario.
            // Si pasa a 4, ya no aparecerá en esta vista.
            await CargarPendientes();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al aprobar",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private async Task Rechazar(EspecialPendienteDto item)
    {
        try
        {
            if (!PuedeAccionar(item))
                return;

            var nivelActual = item.IdEstado switch
            {
                1 => 1,
                2 => 2,
                3 => 3,
                _ => 0
            };

            if (nivelActual == 0)
                return;

            var resultadoDialog = await DialogService.OpenAsync<DialogRechazarTrabajoEspecial>(
                "Motivo de rechazo",
                parameters: new Dictionary<string, object?>
                {
                    { "IdEspecial", item.IdEspecial },
                    { "MotivoActual", item.Motivo }
                },
                options: new DialogOptions
                {
                    Width = "500px",
                    Height = "auto",
                    CloseDialogOnOverlayClick = false,
                    ShowClose = true
                });

            if (resultadoDialog is not string comentarioRechazo || string.IsNullOrWhiteSpace(comentarioRechazo))
            {
                return;
            }

            var dto = new ActualizarEstadoEspecialDto
            {
                NuevoIdEstado = 5,
                Nivel = nivelActual,
                UsuarioAprobador = registroUsuario ?? usuarioActual ?? "Usuario",
                Comentario = comentarioRechazo.Trim()
            };

            await BonoApiService.ActualizarEstadoEspecialAsync(item.IdEspecial, dto);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Registro rechazado",
                Detail = "El pago especial fue rechazado correctamente.",
                Duration = 4000
            });

            // Al pasar a estado 5, ya no debe verse en esta vista.
            await CargarPendientes();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al rechazar",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private async Task VerHistorial(EspecialPendienteDto item)
    {
        try
        {
            if (idEspecialHistorialAbierto == item.IdEspecial && historialSeleccionado.Any())
            {
                historialSeleccionado.Clear();
                idEspecialHistorialAbierto = null;
                usuarioCargaSeleccionado = null;
                return;
            }

            var response = await BonoApiService.ObtenerHistorialEspecialAsync(item.IdEspecial);

            historialSeleccionado = response?.Data ?? new List<HistorialEspecialItemDto>();
            idEspecialHistorialAbierto = item.IdEspecial;

            usuarioCargaSeleccionado = string.IsNullOrWhiteSpace(item.RuserVali)
                ? "No disponible"
                : item.RuserVali;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Error al consultar historial",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }

    private string ObtenerTextoEstado(int estado)
    {
        return estado switch
        {
            1 => "Pendiente Superintendente",
            2 => "Pendiente Gerente Área",
            3 => "Pendiente Gerente Manufactura",
            4 => "Aprobado",
            5 => "Rechazado",
            _ => "Sin estado"
        };
    }

    private string ObtenerTextoBotonHistorial(int idEspecial)
    {
        return idEspecialHistorialAbierto == idEspecial
            ? "Ocultar Historial"
            : "Ver Historial";
    }

    private string ObtenerIconoBotonHistorial(int idEspecial)
    {
        return idEspecialHistorialAbierto == idEspecial
            ? "visibility_off"
            : "visibility";
    }
}