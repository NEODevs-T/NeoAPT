@implements IDisposable

@using NeoAPTB.DTOs.Bono
@using NeoAPTB.Interfaces.Bono
@using NeoAPTB.NeoModels
@using Radzen

@inject IBonoApiService BonoApiService
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenTemplateForm TItem="CrearResumenDto" Data="@modelo" Submit="@Guardar">
    <RadzenStack Gap="1rem">

        <RadzenCard>
            <h5><b>Datos del Trabajador</b></h5>
            <p><b>Ficha:</b> @Trabajador?.PeFicha</p>
            <p><b>Nombre:</b> @Trabajador?.PeNombre @Trabajador?.PeApellido</p>
            <p><b>Grupo:</b> @Trabajador?.PeGrupo</p>
        </RadzenCard>

        <RadzenCard>
            <h5>Datos del trabajo especial</h5>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Fecha" />
                    <RadzenDatePicker @bind-Value="modelo.Rfecha"
                                      Style="width:100%"
                                      DateFormat="dd/MM/yyyy" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Turno" />
                    <RadzenDropDown TValue="int"
                                    Data="@turnosDisponibles"
                                    @bind-Value="modelo.Rturno"
                                    AllowClear="false"
                                    Placeholder="Seleccione turno"
                                    Style="width:100%" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenLabel Text="Horas trabajadas" />
                    <RadzenNumeric @bind-Value="modelo.RhoraTrab"
                                   Min="1"
                                   Style="width:100%" />
                </RadzenColumn>

                <RadzenColumn Size="12">
                    <RadzenLabel Text="Motivo" />
                    <RadzenTextArea @bind-Value="modelo.Motivo"
                                    Rows="4"
                                    Style="width:100%" />
                </RadzenColumn>

                <RadzenColumn Size="12">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenCheckBox @bind-Value="modelo.RisMarcaje" />
                        <RadzenLabel Text="¿Tiene marcaje?" />
                    </div>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
            <RadzenButton Text="Cancelar"
                          ButtonStyle="ButtonStyle.Light"
                          ButtonType="ButtonType.Button"
                          Click="@(async args => await Cancelar())" />

            <RadzenButton Text="Guardar"
                          Icon="save"
                          ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Success"
                          Disabled="@guardando" />
        </RadzenRow>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Personal? Trabajador { get; set; }
    [Parameter] public string UsuarioActual { get; set; } = "Usuario";

    private CrearResumenDto modelo = new();
    private bool _disposed;
    private bool guardando;
    private CancellationTokenSource _cts = new();

    private readonly List<int> turnosDisponibles = new() { 1, 2 };

    protected override void OnInitialized()
    {
        InicializarModelo();
    }

    private void InicializarModelo()
    {
        modelo = new CrearResumenDto
        {
            IdPersonal = Trabajador?.IdPersonal ?? 0,
            Rgrupo = Trabajador?.PeGrupo ?? string.Empty,
            Rfecha = DateTime.Today,

            // valor temporal; se recalcula en Guardar()
            RfechaReal = DateTime.Now,

            // Turno por defecto
            Rturno = 1,

            EsEspecial = true,
            RisMarcaje = true,
            RuserVali = UsuarioActual,
            UsuarioSolicita = UsuarioActual,

            // Valores automáticos
            IdTipSuple = 1,
            IdTipIncen = 1,
            Rsuplido = "",

            // El backend asigna temporalmente 156 si EsEspecial = true
            IdMontos = 0
        };
    }

    private async Task Guardar()
    {
        if (_disposed || guardando)
            return;

        guardando = true;

        try
        {
            modelo.EsEspecial = true;
            modelo.IdPersonal = Trabajador?.IdPersonal ?? 0;
            modelo.Rgrupo = Trabajador?.PeGrupo ?? string.Empty;
            modelo.RuserVali = UsuarioActual;
            modelo.UsuarioSolicita = UsuarioActual;

            // Valores automáticos
            modelo.IdTipSuple = 1;
            modelo.IdTipIncen = 1;
            modelo.Rsuplido = "";

            // Validación fuerte de turno
            if (modelo.Rturno != 1 && modelo.Rturno != 2)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Turno inválido",
                    Detail = "Solo se permite turno 1 o 2.",
                    Duration = 4000
                });

                return;
            }

            var ahora = DateTime.Now;

            // Rfecha = fecha seleccionada + hora actual
            modelo.Rfecha = modelo.Rfecha.Date
                .AddHours(ahora.Hour)
                .AddMinutes(ahora.Minute)
                .AddSeconds(ahora.Second);

            // RfechaReal:
            // turno 2 = día anterior + hora actual
            // turno 1 = misma fecha + hora actual
            modelo.RfechaReal = modelo.Rturno == 2
                ? modelo.Rfecha.Date.AddDays(-1)
                    .AddHours(ahora.Hour)
                    .AddMinutes(ahora.Minute)
                    .AddSeconds(ahora.Second)
                : modelo.Rfecha.Date
                    .AddHours(ahora.Hour)
                    .AddMinutes(ahora.Minute)
                    .AddSeconds(ahora.Second);

            var response = await BonoApiService.InsertarResumenAsync(modelo);

            if (_disposed) return;

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Registro exitoso",
                Detail = response?.Message ?? "Trabajo especial registrado correctamente.",
                Duration = 4000
            });

            if (!_disposed)
            {
                DialogService.Close(true);
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al registrar",
                Detail = ex.Message,
                Duration = 6000
            });
        }
        finally
        {
            guardando = false;
        }
    }

    private Task Cancelar()
    {
        if (_disposed)
            return Task.CompletedTask;

        // Cierre limpio del diálogo lateral
        DialogService.Close();

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
    }
}